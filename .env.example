# SüperArı API — coğrafi veri anahtarları (repo'ya gerçek anahtar koymayın)

# NASA FIRMS sıcak noktaları — https://firms.modaps.eosdis.nasa.gov/api/map_key/
NASA_FIRMS_MAP_KEY=

# WeatherAPI.com (opsiyonel; uygulama varsayılan olarak Open-Meteo kullanır)
WEATHERAPI_KEY=

# Google Earth Engine (ileride NDVI proxy)
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_JSON=
